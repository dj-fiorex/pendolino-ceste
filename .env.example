# The Convex deployment this checkout talks to. `npx convex dev` writes
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL; the site URL is the same
# deployment on its .convex.site domain, where the auth routes live.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# These live on the Convex deployment itself, not in this file:
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#
# And these two carry the mill's email, which is how an Admin invites an
# Operatore and how a forgotten password is replaced (ADR-0008). RESEND_FROM
# has to be an address on a domain the Resend account has verified; without it
# the app writes from Resend's own test sender.
#   npx convex env set RESEND_API_KEY re_...
#   npx convex env set RESEND_FROM "Pendolino Ceste <ceste@frantoio.example>"
#
# With no RESEND_API_KEY the counter works exactly as it does with one: nothing
# on the deployment sends mail, and an invitation shows on the Operatori screen
# as one that never went out, which is where a Resend failure is meant to land.
